<UserControl
    x:Class="WDB.View.TableDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:WDB.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:WDB.View"
    d:DesignHeight="550"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu
            Height="28"
            BorderBrush="LightGray"
            BorderThickness="0,0,0,1">
            <MenuItem
                VerticalAlignment="Center"
                Click="ShaiXuanPaiXu_Click"
                Cursor="Hand">
                <MenuItem.Header>
                    <TextBlock Text="筛选&amp;排序" />
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/filter.png" />
                </MenuItem.Icon>
            </MenuItem>
            <!--  筛选列:点击弹出复选框列表勾选显示/隐藏列  -->
            <MenuItem
                x:Name="MiLie"
                VerticalAlignment="Center"
                Click="MiLie_Click"
                Cursor="Hand"
                Header="筛选列">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/col.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                VerticalAlignment="Center"
                Click="Biaojiegou_Click"
                Cursor="Hand"
                Header="打开表结构">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/table.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                VerticalAlignment="Center"
                Click="Daochu_Click"
                Cursor="Hand"
                Header="导出数据">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/export.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                VerticalAlignment="Center"
                Click="Shuaxin_Click"
                Cursor="Hand"
                Header="刷新">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_refresh.png" />
                </MenuItem.Icon>
            </MenuItem>
        </Menu>
        <!--  筛选列弹层:全选/取消全选 + 复选框列表  -->
        <Popup
            x:Name="PopLie"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=MiLie}"
            PopupAnimation="None"
            StaysOpen="False">
            <Border
                MinWidth="200"
                Padding="10"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.25"
                        ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Width="70"
                            Padding="6,0"
                            Click="BtnLieAll_Click"
                            Content="全选"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Width="80"
                            Margin="8,0,0,0"
                            Padding="6,0"
                            Click="BtnLieNone_Click"
                            Content="取消全选" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="320"
                        Margin="0,8,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LieList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="2,3"
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
        <!--  筛选&排序(默认折叠,由工具栏[筛选&排序]按钮控制显示)  -->
        <Border
            x:Name="BorderKuaisu"
            Grid.Row="1"
            Padding="8"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  条件与排序(可滚动区域)  -->
                <ScrollViewer
                    x:Name="SvKuaisu"
                    Grid.Row="0"
                    MaxHeight="300"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  条件(AND/OR 放在行末)  -->
                        <StackPanel Grid.Row="0">
                            <ItemsControl ItemsSource="{Binding TiaoJianList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding Enable}"
                                                ToolTip="取消勾选则该行不参与本次查询" />
                                            <ComboBox
                                                Grid.Column="1"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding DataContext.ZiDuanList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                SelectedValue="{Binding Field}"
                                                SelectedValuePath="Name" />
                                            <ComboBox
                                                Grid.Column="2"
                                                Margin="4,0,0,0"
                                                ItemsSource="{Binding DataContext.CaoZuoFuList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                MaxDropDownHeight="450"
                                                SelectedItem="{Binding CaoZuoFu}" />
                                            <TextBox
                                                Grid.Column="3"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                hc:InfoElement.Placeholder="条件值"
                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox
                                                x:Name="CbGuanXi"
                                                Grid.Column="4"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ItemsSource="{Binding DataContext.GuanXiList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                SelectedItem="{Binding GuanXi}" />
                                            <Button
                                                Grid.Column="5"
                                                Width="45"
                                                Margin="6,0,0,0"
                                                Click="BtnTiaoJianDelete_Click"
                                                Content="删除"
                                                Foreground="DarkRed"
                                                Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Width="100"
                                Margin="0,3,0,0"
                                Padding="6,0"
                                HorizontalAlignment="Left"
                                Click="BtnTiaoJianAdd_Click"
                                Content="添加查询条件"
                                Foreground="DarkGreen" />
                        </StackPanel>

                        <!--  排序:直接跟在[添加排序规则]按钮后面,多个不换行,放不下显示横向滚动条  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="100"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Click="BtnPaiXuAdd_Click"
                                    Content="添加排序规则"
                                    Foreground="DarkGreen" />
                                <ItemsControl ItemsSource="{Binding PaiXuList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding Enable}"
                                                    ToolTip="取消勾选则该行不参与本次查询" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    DisplayMemberPath="Display"
                                                    ItemsSource="{Binding DataContext.ZiDuanList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    SelectedValue="{Binding Field}"
                                                    SelectedValuePath="Name" />
                                                <ComboBox
                                                    Grid.Column="2"
                                                    Margin="4,0,0,0"
                                                    ItemsSource="{Binding DataContext.PaiXuFangXiangList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    SelectedItem="{Binding FangXiang}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Width="45"
                                                    Margin="4,0,0,0"
                                                    Click="BtnPaiXuDelete_Click"
                                                    Content="删除"
                                                    Foreground="DarkRed"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ScrollViewer>

                <!--  去重/操作按钮(固定在面板底部)  -->
                <WrapPanel
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="去重 DISTINCT"
                        IsChecked="{Binding QuChong}" />
                    <Button
                        Width="100"
                        Margin="20,0,0,0"
                        Click="BtnApply_Click"
                        Content="筛选&amp;排序"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="按当前条件与排序直接查询" />
                    <Button
                        Width="90"
                        Margin="10,0,0,0"
                        Click="BtnSql_Click"
                        Content="查询语句"
                        ToolTip="按当前条件与排序生成查询语句" />
                    <Button
                        Width="90"
                        Margin="10,0,0,0"
                        Click="BtnQingkong_Click"
                        Content="清空" />
                </WrapPanel>
            </Grid>
        </Border>
        <!--  数据区(只保留一个表格)  -->
        <ContentControl x:Name="GridHost" Grid.Row="2" />
        <!--  分页条  -->
        <Border
            Grid.Row="3"
            Padding="8,4"
            BorderBrush="LightGray"
            BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Foreground="Gray"
                    Text="{Binding PageInfo}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Width="60"
                        Margin="4,0,0,0"
                        Click="BtnFirstPage_Click"
                        Content="首页"
                        IsEnabled="{Binding CanPrev}"
                        ToolTip="第一页" />
                    <Button
                        Width="70"
                        Margin="4,0,0,0"
                        Click="BtnPrevPage_Click"
                        Content="上一页"
                        IsEnabled="{Binding CanPrev}" />
                    <Button
                        Width="70"
                        Margin="4,0,0,0"
                        Click="BtnNextPage_Click"
                        Content="下一页"
                        IsEnabled="{Binding HasNext}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="每页" />
                    <ComboBox
                        Width="80"
                        Margin="4,0,0,0"
                        ItemContainerStyle="{StaticResource DropdownItemStyle}"
                        ItemsSource="{Binding PageSizeList}"
                        SelectedItem="{Binding PageSize}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Text="条" />
                </StackPanel>
            </DockPanel>
        </Border>
        <view:Loading
            x:Name="LoadingG"
            Grid.Row="0"
            Grid.RowSpan="4"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
