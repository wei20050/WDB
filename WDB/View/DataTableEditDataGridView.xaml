<UserControl
    x:Class="WDB.View.DataTableEditDataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:WDB.View"
    d:DesignHeight="550"
    d:DesignWidth="800"
    DataContextChanged="UserControl_DataContextChanged"
    KeyDown="UserControl_KeyDown"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <view:DataTableEditDataGrid
            x:Name="dg"
            ItemsSource="{Binding Dt}"
            MouseRightButtonDown="dg_MouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="SnapsToDevicePixels" Value="true" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Padding" Value="0,6" />
                    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                    <Setter Property="ValidationErrorTemplate">
                        <Setter.Value>
                            <ControlTemplate>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="Red"
                                    Text="!" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <Border
                                        x:Name="DGR_Border"
                                        Grid.ColumnSpan="2"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True" />
                                    <DataGridCellsPresenter
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        VerticalContentAlignment="Center"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    <DataGridDetailsPresenter
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Visibility="{TemplateBinding DetailsVisibility}" />
                                    <DataGridRowHeader
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </SelectiveScrollingGrid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextIconBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="true" />
                                <Condition Property="Selector.IsSelectionActive" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DarkDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="Fz_Click" Header="复制">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="Fzlm_Click" Header="复制列名" />
                    <MenuItem Click="FzlmXtf_Click" Header="复制列名(小驼峰)" />
                    <MenuItem Click="FzlmDtf_Click" Header="复制列名(大驼峰)" />
                    <MenuItem Click="FzlmSxxx_Click" Header="复制列名(蛇形小写)" />
                    <Separator Margin="0,0,10,0" />
                    <MenuItem
                        Name="miFilter"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Header="插入一个过滤条件">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/filter.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Margin="0,0,10,0" />
                    <MenuItem
                        Name="miOrderBy"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Header="插入一个排序条件">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/sort.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Margin="0,0,10,0" />
                    <MenuItem
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Header="创建SQL">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/sql_script_create.png" />
                        </MenuItem.Icon>
                        <MenuItem
                            Name="SELECT"
                            Click="Cj_Click"
                            Header="SELECT (当前行)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="SELECTX"
                            Click="Cj_Click"
                            Header="SELECT (已选列)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="SELECTWHERE"
                            Click="Cj_Click"
                            Header="SELECT (已选列为条件)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="INSERT"
                            Click="Cj_Click"
                            Header="INSERT (当前行)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="INSERTX"
                            Click="Cj_Click"
                            Header="INSERT (已选列)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="UPDATE"
                            Click="Cj_Click"
                            Header="UPDATE (当前行)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="UPDATEX"
                            Click="Cj_Click"
                            Header="UPDATE (已选列)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Name="DELETE"
                            Click="Cj_Click"
                            Foreground="DarkRed"
                            Header="DELETE (当前行)">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/WDB;component/Resources/sql_text.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <Separator Margin="0,0,10,0" />
                    <MenuItem
                        Name="miView"
                        Click="MenuChakan_Click"
                        Header="查看">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/view.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Name="miEdit"
                        Click="MenuBianji_Click"
                        Header="编辑">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/row_edit.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Name="miSetNull"
                        Click="MenuNull_Click"
                        Header="设为空 ( NULL )" />
                    <MenuItem
                        Name="miSetEmpty"
                        Click="MenuEmpty_Click"
                        Header="设为空字符串 ( Empty )" />
                    <MenuItem
                        Name="miSetTime"
                        Click="MenuTime_Click"
                        Header="设为当前时间 ( yyyy-MM-dd HH:mm:ss )" />
                    <MenuItem
                        Name="miAdd"
                        Click="MenuXinzenh_Click"
                        Header="新增">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/row_add.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Name="miCopyRow"
                        Click="MenuFuzhih_Click"
                        Header="复制">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/row_copy.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Name="miDeleteRow"
                        Click="MenuShanchuh_Click"
                        Header="删除">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/row_delete.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </view:DataTableEditDataGrid>
        <Menu
            Name="MenuEdit"
            Grid.Row="1"
            Height="28"
            BorderBrush="LightGray"
            BorderThickness="0,1,0,0">
            <MenuItem Click="MenuBaocun_Click" Header="保存">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_save.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuShengcheng_Click" Header="预览">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/sql_script_create.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuQuxiao_Click" Header="取消">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_cancel.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuBianji_Click" Header="编辑">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_edit.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuXinzenh_Click" Header="新增">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_add.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuFuzhih_Click" Header="复制">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_copy.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuShanchuh_Click" Header="删除">
                <MenuItem.Icon>
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/WDB;component/Resources/row_delete.png" />
                </MenuItem.Icon>
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
