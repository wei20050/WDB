<UserControl
    x:Class="WDB.View.TabNoDbView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:common="clr-namespace:WDB.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="800"
    DataContextChanged="UserControl_DataContextChanged"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>
        <Grid Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label
                Margin="3,3,0,3"
                HorizontalAlignment="Right"
                Content="key:"
                Style="{StaticResource BaseStyle}" />
            <hc:TextBox
                Grid.Column="1"
                Margin="0,3,5,3"
                hc:InfoElement.Placeholder="请输入Redis Key"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding NoDbKey, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="txtKey_TextChanged" />
            <Button
                Grid.Column="2"
                Margin="0,3,0,3"
                HorizontalAlignment="Left"
                Click="BtnChaxun_Click"
                Style="{StaticResource ButtonPrimary}">
                重新加载数据
            </Button>
        </Grid>
        <DataGrid
            Name="dg"
            Grid.Row="1"
            hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
            hc:DataGridAttach.ShowRowNumber="True"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding NoDbDataBindList, UpdateSourceTrigger=PropertyChanged}"
            RowHeaderWidth="60"
            SelectedCellsChanged="dg_SelectedCellsChanged"
            SelectionMode="Extended"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Key}"
                    Header="key" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="Fz_Click" Header="复制">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <GridSplitter
            Grid.Row="2"
            Width="Auto"
            Height="3"
            HorizontalAlignment="Stretch"
            Background="#EEEEEE"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Menu
                Height="30"
                BorderBrush="LightGray"
                BorderThickness="0,1,0,1">
                <MenuItem Click="BtnXinzen" Header="新增">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/WDB;component/Resources/row_add.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="BtnBaocun" Header="保存">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/WDB;component/Resources/row_save.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="BtnShanchu" Header="删除选中行">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/WDB;component/Resources/row_delete.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </Menu>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Name="LabZhuangtai"
                            Width="60"
                            Content="新增"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="DarkGreen"
                            Style="{StaticResource BaseStyle}" />
                        <hc:NumericUpDown
                            Width="200"
                            Margin="0,3,0,3"
                            hc:InfoElement.Title="TTL:"
                            hc:InfoElement.TitlePlacement="Left"
                            Minimum="-1"
                            Style="{StaticResource NumericUpDownExtend}"
                            Value="{Binding NoDbDataEdit.Ttl, UpdateSourceTrigger=PropertyChanged}" />
                        <Label
                            Margin="3,3,0,3"
                            Content="Type:"
                            Style="{StaticResource BaseStyle}" />
                        <Label
                            Margin="0,3,0,3"
                            Content="{Binding NoDbDataEdit.Type, UpdateSourceTrigger=PropertyChanged}"
                            FontWeight="Bold"
                            Style="{StaticResource BaseStyle}" />
                        <Label
                            Margin="3,3,0,3"
                            Content="最近刷新:"
                            Style="{StaticResource BaseStyle}" />
                        <Label
                            Name="labShuaxin"
                            Margin="0,3,0,3"
                            Content="00:00:00"
                            FontWeight="Bold"
                            Style="{StaticResource BaseStyle}" />
                        <Button
                            Margin="3,3,5,3"
                            HorizontalAlignment="Left"
                            Click="BtnShuaxin_Click"
                            Style="{StaticResource ButtonPrimary}">
                            刷新数据
                        </Button>
                        <CheckBox Name="CbZidong" Margin="0,3,5,3">
                            自动刷新
                        </CheckBox>
                    </StackPanel>
                    <Grid Grid.Row="1" Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Margin="3,3,0,3"
                            HorizontalAlignment="Right"
                            Content="key:"
                            Style="{StaticResource BaseStyle}" />
                        <hc:TextBox
                            Name="txtKeyEdit"
                            Grid.Column="1"
                            Margin="0,3,5,3"
                            hc:InfoElement.Placeholder="请输入Redis Key"
                            hc:InfoElement.ShowClearButton="True"
                            Text="{Binding NoDbDataEdit.Key, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Margin="3,3,0,3"
                        HorizontalAlignment="Right"
                        Content="value:"
                        Style="{StaticResource BaseStyle}" />
                    <avalonedit:TextEditor
                        Name="TextEditor"
                        Grid.Column="1"
                        Margin="1,0,5,5"
                        BorderBrush="DarkGray"
                        BorderThickness="1"
                        FontSize="{Binding Path=(common:StaticVar.TextFontSize), Mode=OneWay}"
                        ShowLineNumbers="True"
                        TextChanged="TextEditor_TextChanged"
                        WordWrap="True">
                        <avalonedit:TextEditor.ContextMenu>
                            <ContextMenu Name="TreeContextMenu" Visibility="Visible">
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="MenuCopy_Click"
                                    Cursor="Hand"
                                    Header="复制">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="MenuPaste_Click"
                                    Cursor="Hand"
                                    Header="粘贴">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/paste.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="MenuDelete_Click"
                                    Cursor="Hand"
                                    Header="删除">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/delete.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Margin="0,0,10,0" />
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="Ningcunwei_Click"
                                    Cursor="Hand"
                                    Header="另存为...">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/save_as.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </avalonedit:TextEditor.ContextMenu>
                        <avalonedit:TextEditor.Options>
                            <avalonedit:TextEditorOptions EnableTextDragDrop="True" />
                        </avalonedit:TextEditor.Options>
                    </avalonedit:TextEditor>
                </Grid>
            </Grid>
        </Grid>


    </Grid>
</UserControl>
