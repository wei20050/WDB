<UserControl
    x:Class="WDB.View.AiChatTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WDB.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!--  输入区的工具栏按钮(图片):描边圆角、悬停浅灰底,和网页版输入框一致  -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#DDE1E7"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F4F7" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9D0D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6EAF0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  气泡里的小文字按钮(复制):无边框,悬停浅灰底,不抢正文视觉  -->
        <Style x:Key="MiniLinkButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A8F99" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9ECF1" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE0E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  顶部:标题 + 模型下拉 + 新对话  -->
            <Border
                Grid.Row="0"
                Padding="16,10"
                Background="White"
                BorderBrush="#E6E8EB"
                BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Image
                            Width="20"
                            Height="20"
                            Source="pack://application:,,,/WDB;component/Resources/ai.png" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Text="AI 对话" />
                        <Button
                            Width="72"
                            Margin="20,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BtnNew_Click"
                            Content="新对话"
                            Cursor="Hand"
                            ToolTip="清空当前对话重新开始" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  对话区:自己在右、AI 在左,代码块等宽显示,内容可选中复制  -->
            <ScrollViewer
                x:Name="Scroller"
                Grid.Row="1"
                Padding="16,14"
                Background="#F7F8FA"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820">
                    <ItemsControl x:Name="IcChat">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="Bubble"
                                    MaxWidth="760"
                                    Margin="0,0,0,14"
                                    Padding="12,10"
                                    HorizontalAlignment="Left"
                                    Background="White"
                                    BorderBrush="#E6E8EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <StackPanel
                                            x:Name="Head"
                                            Margin="0,0,0,6"
                                            Orientation="Horizontal">
                                            <Border
                                                x:Name="Avatar"
                                                Width="20"
                                                Height="20"
                                                Background="#4D6BFE"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="White"
                                                    Text="AI" />
                                            </Border>
                                            <TextBlock
                                                x:Name="TxtWho"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#6B7280"
                                                Text="AI" />
                                            <Button
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Click="BtnCopy_Click"
                                                Content="复制"
                                                Style="{StaticResource MiniLinkButton}"
                                                Tag="{Binding}"
                                                ToolTip="复制这条消息的全文" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        x:Name="SegBox"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        CornerRadius="6">
                                                        <TextBox
                                                            x:Name="SegText"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            FontSize="13"
                                                            IsReadOnly="True"
                                                            Text="{Binding Text, Mode=OneWay}"
                                                            TextWrapping="Wrap"
                                                            VerticalScrollBarVisibility="Disabled" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                            <Setter TargetName="SegBox" Property="Margin" Value="0,4" />
                                                            <Setter TargetName="SegBox" Property="Padding" Value="8,6" />
                                                            <Setter TargetName="SegBox" Property="Background" Value="#F6F8FA" />
                                                            <Setter TargetName="SegBox" Property="BorderBrush" Value="#E4E7EB" />
                                                            <Setter TargetName="SegBox" Property="BorderThickness" Value="1" />
                                                            <Setter TargetName="SegText" Property="FontFamily" Value="Consolas" />
                                                            <Setter TargetName="SegText" Property="FontSize" Value="12.5" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl
                                            Margin="0,6,0,0"
                                            ItemsSource="{Binding Images}"
                                            Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,8,8"
                                                        BorderBrush="#E4E7EB"
                                                        BorderThickness="1"
                                                        ClipToBounds="True"
                                                        CornerRadius="6">
                                                        <Image
                                                            MaxWidth="180"
                                                            MaxHeight="180"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="BubbleImage_Click"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding}"
                                                            Stretch="Uniform"
                                                            Tag="{Binding}"
                                                            ToolTip="点击查看大图" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!--  自己的消息:靠右、浅蓝底,不显示头像但仍可复制  -->
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="#EFF6FF" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#DBEAFE" />
                                        <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="TxtWho" Property="Text" Value="我" />
                                        <Setter TargetName="TxtWho" Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background" Value="#FFF3F3" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#F0C9C9" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="TxtEmpty"
                        Margin="0,60,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="#9AA0AA"
                        Text="有什么可以帮你的吗?输入问题或直接粘贴图片开始对话" />
                    <TextBlock
                        x:Name="TxtThinking"
                        Margin="0,0,0,10"
                        FontSize="12"
                        FontStyle="Italic"
                        Foreground="#8A8F99"
                        Text="AI 正在思考..."
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!--  输入区:待发送图片预览 + 输入框 + 图片/发送按钮  -->
            <Border
                Grid.Row="2"
                Padding="16,10"
                Background="White"
                BorderBrush="#E6E8EB"
                BorderThickness="0,1,0,0">
                <StackPanel MaxWidth="820">
                    <ItemsControl
                        x:Name="IcAttach"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Width="72"
                                    Height="72"
                                    Margin="0,0,10,0">
                                    <Border
                                        BorderBrush="#E4E7EB"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="6">
                                        <Image
                                            Width="72"
                                            Height="72"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="AttachImage_Click"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding Thumbnail}"
                                            Stretch="UniformToFill"
                                            Tag="{Binding}"
                                            ToolTip="点击查看大图" />
                                    </Border>
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Margin="0,-8,-8,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="BtnRemoveImage_Click"
                                        Content="✕"
                                        Cursor="Hand"
                                        FontSize="9"
                                        Tag="{Binding}"
                                        ToolTip="移除这张图片" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        x:Name="InputBox"
                        Padding="10,8"
                        AllowDrop="True"
                        Background="White"
                        BorderBrush="#D9DDE3"
                        BorderThickness="1"
                        CornerRadius="10"
                        DragOver="InputBox_DragOver"
                        Drop="InputBox_Drop">
                        <StackPanel>
                            <TextBox
                                x:Name="TxtInput"
                                MinHeight="52"
                                MaxHeight="180"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                hc:InfoElement.Placeholder="给 AI 发送消息(Ctrl+V 可粘贴图片)"
                                AcceptsReturn="True"
                                PreviewKeyDown="TxtInput_PreviewKeyDown"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto" />
                            <Grid Margin="0,6,0,0">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnImage"
                                        Click="BtnImage_Click"
                                        Style="{StaticResource ToolButton}"
                                        ToolTip="选择图片(可多选,也支持 Ctrl+V 粘贴或拖拽图片进来)">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  小图片图标:相框 + 山 + 太阳  -->
                                            <Viewbox
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center">
                                                <Canvas Width="16" Height="16">
                                                    <Path
                                                        Data="M2,3.2 H14 A1,1 0 0 1 15,4.2 V11.8 A1,1 0 0 1 14,12.8 H2 A1,1 0 0 1 1,11.8 V4.2 A1,1 0 0 1 2,3.2 Z"
                                                        Stroke="#6B7280"
                                                        StrokeThickness="1.4" />
                                                    <Path Data="M2.6,11.6 L6,7.4 L8.6,10.4 L10.2,8.6 L13.4,11.6 Z" Fill="#6B7280" />
                                                    <Ellipse
                                                        Width="2.4"
                                                        Height="2.4"
                                                        Canvas.Left="4"
                                                        Canvas.Top="5"
                                                        Fill="#6B7280" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="图片" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        x:Name="TxtAttach"
                                        MaxWidth="330"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="支持 jpg / png,需选择支持识图的模型"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!--  模型下拉紧挨发送按钮:切换模型不用再跑到顶部  -->
                                    <ComboBox
                                        x:Name="CbModel"
                                        Width="170"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Name"
                                        ItemContainerStyle="{StaticResource DropdownItemStyle}"
                                        ToolTip="本次对话所用的大模型(在设置里维护多套,需要支持识图的模型才能识别图片)" />
                                    <Button
                                        x:Name="BtnSend"
                                        Width="80"
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Click="BtnSend_Click"
                                        Content="发送"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonPrimary}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="Gray"
                        Text="Enter 发送,Ctrl/Shift+Enter 换行" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
