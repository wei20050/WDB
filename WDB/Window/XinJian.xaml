<hc:Window
    x:Class="WDB.Window.XinJian"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrol="clr-namespace:WDB.View"
    Width="600"
    Height="520"
    Background="{DynamicResource SecondaryRegionBrush}"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <GroupBox
                Name="GroupBoxMain"
                Margin="10"
                Header="新建 Mysql">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            连接名称:
                        </Label>
                        <hc:TextBox
                            Name="txtLianjiemingchen"
                            Width="450"
                            Margin="10"
                            hc:InfoElement.Placeholder="请输入连接名称"
                            hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            数据库类型:
                        </Label>
                        <hc:ComboBox
                            Name="cbLeixin"
                            Width="450"
                            Margin="10"
                            ItemContainerStyle="{StaticResource DropdownItemStyle}"
                            SelectionChanged="cbLeixin_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            主机:
                        </Label>
                        <hc:TextBox
                            Name="txtZhuji"
                            Width="450"
                            Margin="10"
                            hc:InfoElement.Placeholder="请输入主机地址"
                            hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            端口:
                        </Label>
                        <hc:TextBox
                            Name="txtDuankou"
                            Width="100"
                            Margin="10"
                            hc:InfoElement.Placeholder="请输入端口号"
                            hc:InfoElement.ShowClearButton="True" />
                        <Label
                            Name="labFuwuming"
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="服务名:"
                            Style="{StaticResource BaseStyle}" />
                        <hc:TextBox
                            Name="txtFuwuming"
                            Width="240"
                            Margin="10"
                            hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            账号:
                        </Label>
                        <hc:TextBox
                            Name="txtZhanghao"
                            Width="450"
                            Margin="10"
                            hc:InfoElement.Placeholder="请输入账号"
                            hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            hc:InfoElement.Placeholder="请输入密码"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            密码:
                        </Label>
                        <hc:PasswordBox
                            Name="txtMima"
                            Width="450"
                            Margin="10"
                            hc:InfoElement.Necessary="True"
                            hc:InfoElement.Placeholder="请输入密码"
                            hc:InfoElement.ShowClearButton="True"
                            ShowEyeButton="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Name="labShujuku"
                            Width="80"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            默认数据库:
                        </Label>
                        <hc:TextBox
                            Name="txtShujuku"
                            Width="450"
                            Margin="10"
                            hc:InfoElement.Placeholder="请输入默认数据库"
                            hc:InfoElement.ShowClearButton="True" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <Button
            Width="100"
            Margin="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Click="BtnCeshi"
            Content="测试"
            Style="{StaticResource ButtonPrimary}" />
        <Button
            Width="100"
            Margin="0,0,150,30"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            hc:IconElement.Geometry="{StaticResource SaveGeometry}"
            Click="BtnQueding"
            Content="保存"
            Style="{StaticResource ButtonPrimary}" />
        <Button
            Width="100"
            Margin="30"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
            Background="DarkRed"
            BorderThickness="0"
            Click="BtnQuxiao"
            Content="关闭"
            Style="{StaticResource ButtonPrimary}" />
        <usercontrol:Loading x:Name="LoadingG" Visibility="Collapsed" />
    </Grid>
</hc:Window>
