<hc:Window
    x:Class="WDB.Window.BiaoGuolv"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="表过滤"
    Width="600"
    Height="760"
    Background="{DynamicResource SecondaryRegionBrush}"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DataTemplate x:Key="EditableListBoxItemTemplate">
            <Grid Width="520" Height="35">
                <StackPanel x:Name="viewPanel" Orientation="Horizontal">
                    <TextBlock
                        Width="380"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding Content}" />
                    <Button
                        Width="60"
                        Margin="5,0"
                        Click="EditButton_Click"
                        Content="编辑"
                        Foreground="DarkGreen" />
                    <Button
                        Width="60"
                        Margin="5,0"
                        Click="DeleteButton_Click"
                        Content="删除"
                        Foreground="DarkRed" />
                </StackPanel>
                <StackPanel
                    x:Name="editPanel"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <TextBox
                        Width="380"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Width="60"
                        Margin="5,0"
                        Click="SaveButton_Click"
                        Content="保存"
                        Foreground="DarkGreen" />
                    <Button
                        Width="60"
                        Margin="5,0"
                        Click="CancelButton_Click"
                        Content="取消" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="viewPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="editPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <StackPanel>
            <GroupBox
                Name="GroupBoxMain"
                Margin="10"
                Header="配置过滤规则">
                <StackPanel>
                    <!--  过滤语法提示:原先在窗口标题里,太挤看不全,挪到开关上方并补充用法  -->
                    <Border
                        Margin="10,10,10,0"
                        Padding="10,8"
                        Background="#F5F7FA"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#606266"
                                Text="通配符:* 匹配任意多个字符(含 0 个),_ 匹配单个字符;不区分大小写;不含通配符时全名匹配。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#909399"
                                Text="示例:tb_* 匹配 tb_user、tb_order;user_ 匹配 user1、userA;temp 只匹配 temp。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#909399"
                                Text="包括:只显示命中的名称(条目为空时不限制);排除:命中的名称不显示,且排除优先于包括。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <CheckBox Name="cbQiyong" Margin="10">启用过滤 (未勾选时所有规则不生效)</CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Margin="5,5,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            包括:
                        </Label>
                        <Button
                            Width="80"
                            Margin="5,5,0,5"
                            Click="BtnTianjiaB">
                            添加条目
                        </Button>
                        <Button
                            Width="80"
                            Margin="5,5,0,5"
                            Click="BtnQingkongB"
                            Foreground="DarkRed">
                            清空条目
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ListBox
                            Name="lbBaokuo"
                            Width="543"
                            Height="200"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            ItemTemplate="{StaticResource EditableListBoxItemTemplate}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Margin="5,5,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource BaseStyle}">
                            排除:
                        </Label>
                        <Button
                            Width="80"
                            Margin="5,5,0,5"
                            Click="BtnTianjiaP">
                            添加条目
                        </Button>
                        <Button
                            Width="80"
                            Margin="5,5,0,5"
                            Click="BtnQingkongP"
                            Foreground="DarkRed">
                            清空条目
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <ListBox
                            Name="lbPaichu"
                            Width="543"
                            Height="200"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            ItemTemplate="{StaticResource EditableListBoxItemTemplate}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <Button
            Width="100"
            Margin="30,0,130,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            hc:IconElement.Geometry="{StaticResource SaveGeometry}"
            Click="BtnQueding"
            Content="保存"
            Style="{StaticResource ButtonPrimary}" />
        <Button
            Width="100"
            Margin="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
            Background="DarkRed"
            BorderThickness="0"
            Click="BtnQuxiao"
            Content="关闭"
            Style="{StaticResource ButtonPrimary}" />
    </Grid>
</hc:Window>
