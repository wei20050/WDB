<hc:Window
    x:Class="WDB.Window.SqlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:common="clr-namespace:WDB.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Title="SQL预览"
    Width="800"
    Height="600"
    Background="{DynamicResource SecondaryRegionBrush}"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>

        <Border
            Margin="5"
            Background="White"
            CornerRadius="8">
            <Grid Margin="18">
                <Border Background="#f9f9f9" CornerRadius="8">
                    <Grid>
                        <avalonedit:TextEditor
                            x:Name="TextEditor"
                            Margin="10,0,10,49"
                            Padding="0,5,5,5"
                            FontSize="{Binding Path=(common:StaticVar.TextFontSize), Mode=OneWay}"
                            ShowLineNumbers="True"
                            WordWrap="True">
                            <avalonedit:TextEditor.ContextMenu>
                                <ContextMenu Name="TreeContextMenu" Visibility="Visible">
                                    <MenuItem
                                        VerticalAlignment="Center"
                                        Click="MenuCopy_Click"
                                        Cursor="Hand"
                                        Header="复制">
                                        <MenuItem.Icon>
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        VerticalAlignment="Center"
                                        Click="MenuPaste_Click"
                                        Cursor="Hand"
                                        Header="粘贴">
                                        <MenuItem.Icon>
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="pack://application:,,,/WDB;component/Resources/paste.png" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        VerticalAlignment="Center"
                                        Click="MenuDelete_Click"
                                        Cursor="Hand"
                                        Header="删除">
                                        <MenuItem.Icon>
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="pack://application:,,,/WDB;component/Resources/delete.png" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Margin="0,0,10,0" />
                                    <MenuItem
                                        VerticalAlignment="Center"
                                        Click="Ningcunwei_Click"
                                        Cursor="Hand"
                                        Header="另存为...">
                                        <MenuItem.Icon>
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="pack://application:,,,/WDB;component/Resources/save_as.png" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </avalonedit:TextEditor.ContextMenu>
                            <avalonedit:TextEditor.Options>
                                <avalonedit:TextEditorOptions ShowSpaces="False">
                                    <avalonedit:TextEditorOptions.ColumnRulerPosition>
                                        <system:Int32>10</system:Int32>
                                    </avalonedit:TextEditorOptions.ColumnRulerPosition>
                                </avalonedit:TextEditorOptions>
                            </avalonedit:TextEditor.Options>
                        </avalonedit:TextEditor>

                        <Grid Margin="10">
                            <StackPanel
                                Height="30"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnFormatter"
                                    Width="80"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    hc:IconElement.Geometry="{StaticResource CodeEGeometry}"
                                    Click="BtnFormatter_Click"
                                    Content="格式化"
                                    Cursor="Hand"
                                    Style="{StaticResource ButtonSuccess}" />
                                <Button
                                    x:Name="BtnCompress"
                                    Width="80"
                                    Height="28"
                                    Margin="10,0,0,0"
                                    hc:IconElement.Geometry="{StaticResource YaSuoGeometry}"
                                    Click="BtnCompress_Click"
                                    Content="压缩"
                                    Cursor="Hand"
                                    Style="{StaticResource ButtonWarning}" />
                                <Button
                                    x:Name="BtnCopyScript"
                                    Width="80"
                                    Height="28"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
                                    Click="BtnCopyScript_Click"
                                    Content="复制"
                                    Cursor="Hand"
                                    Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                            <Button
                                Width="80"
                                Height="28"
                                Margin="0,0,90,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                hc:IconElement.Geometry="{StaticResource ClearGeometry}"
                                BorderThickness="0.6"
                                Click="BtnClearScript_Click"
                                Content="清空"
                                Cursor="Hand" />
                            <Button
                                x:Name="BtnClose"
                                Width="80"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Background="DarkRed"
                                BorderThickness="0"
                                Click="BtnClose_Click"
                                Content="关闭"
                                Cursor="Hand"
                                Foreground="White" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
