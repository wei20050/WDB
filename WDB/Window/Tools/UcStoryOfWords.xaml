<UserControl
    x:Class="WDB.Window.Tools.UcStoryOfWords"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="800"
    Loaded="UcStoryOfWords_OnLoaded"
    mc:Ignorable="d">
    <Border
        Margin="5"
        Background="White"
        CornerRadius="8">
        <Grid Margin="18">
            <Grid
                Height="40"
                Margin="0,-5,0,0"
                VerticalAlignment="Top"
                Background="#f9f9f9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        工具箱
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        /
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        文字物语
                    </TextBlock>
                </StackPanel>
                <TextBlock
                    Margin="10,10,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockSubTitleBold}"
                    Text="文字物语" />
                <Button
                    x:Name="BtnReturn"
                    Width="60"
                    Height="28"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0.4"
                    Click="BtnReturn_Click"
                    Content="返回"
                    Cursor="Hand" />
            </Grid>

            <Border
                Margin="0,43,0,0"
                Background="#f9f9f9"
                CornerRadius="8">
                <StackPanel>
                    <Border
                        Name="Box"
                        Height="300"
                        Margin="18"
                        VerticalAlignment="Top"
                        CornerRadius="8">
                        <StackPanel
                            Margin="0,35,0,0"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Name="TextContent"
                                    Margin="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    FontFamily="Microsoft YaHei"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    Name="TextAuthor"
                                    Margin="10,30,50,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Microsoft YaHei"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            x:Name="BtnReplace"
                            Width="105"
                            Height="28"
                            Click="BtnReplace_OnClick"
                            Content="换一句"
                            Cursor="Hand"
                            Style="{StaticResource ButtonSuccess}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
