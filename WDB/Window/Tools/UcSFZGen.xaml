                                x:Name="BtnCopy"
                                Width="150"
                                Margin="10,0,0,0"
                                VerticalAlignment="Top"
                                hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
                                Click="BtnCopy_Click"
