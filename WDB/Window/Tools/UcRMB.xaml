<UserControl
    x:Class="WDB.Window.Tools.UcRMB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Margin="5"
        Background="White"
        CornerRadius="8">
        <Grid Margin="18">
            <Grid
                Height="40"
                Margin="0,-5,0,0"
                VerticalAlignment="Top"
                Background="#f9f9f9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        工具箱
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        /
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        人民币大写转换
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    Margin="10,10,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockSubTitleBold}"
                    Text="人民币大写转换" />
                <Button
                    x:Name="BtnReturn"
                    Width="60"
                    Height="28"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0.4"
                    Click="BtnReturn_Click"
                    Content="返回"
                    Cursor="Hand" />
            </Grid>

            <Border
                Margin="0,43,0,0"
                VerticalAlignment="Stretch"
                Background="#f9f9f9"
                CornerRadius="8">
                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBox
                        Name="txtInput"
                        Margin="15,10,15,0"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        hc:InfoElement.Placeholder="请输入金额"
                        hc:InfoElement.Title="请输入小写金额"
                        Style="{StaticResource TextBoxExtend}" />
                    <Grid Grid.Row="1" Margin="15,15,0,0">
                        <Button
                            x:Name="BtnConvert"
                            Width="120"
                            Height="28"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Left"
                            Click="BtnConvert_Click"
                            Content="转换为大写金额"
                            Cursor="Hand"
                            Style="{StaticResource ButtonSuccess}" />
                        <Button
                            x:Name="BtnCopy"
                            Width="120"
                            Height="28"
                            Margin="130,0,0,0"
                            HorizontalAlignment="Left"
                            hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
                            Click="BtnCopy_Click"
                            Content="复制结果"
                            Cursor="Hand"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            x:Name="BtnClear"
                            Width="80"
                            Height="28"
                            Margin="0,0,15,0"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource ClearGeometry}"
                            BorderThickness="0.6"
                            Click="BtnClear_Click"
                            Content="清空"
                            Cursor="Hand" />
                    </Grid>
                    <TextBox
                        x:Name="TextOutput"
                        Grid.Row="2"
                        Margin="15,10,15,0"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        hc:InfoElement.Placeholder="转换结果"
                        hc:InfoElement.Title="转换拼音后的结果："
                        IsReadOnly="True"
                        Style="{StaticResource TextBoxExtend}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
