<UserControl
    x:Class="WDB.Window.Tools.UcSqlFormatter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="550"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Margin="5"
        Background="White"
        CornerRadius="8">
        <Grid Margin="18">
            <Grid
                Height="40"
                Margin="0,-5,0,0"
                VerticalAlignment="Top"
                Background="#f9f9f9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        工具箱
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        /
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        SQL格式化
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    Margin="10,10,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockSubTitleBold}"
                    Text="SQL格式化" />
                <Button
                    x:Name="BtnReturn"
                    Width="60"
                    Height="28"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0.4"
                    Click="BtnReturn_Click"
                    Content="返回"
                    Cursor="Hand" />
            </Grid>
            <Border
                Margin="0,45,0,0"
                Background="#f9f9f9"
                CornerRadius="8">
                <Grid>
                    <avalonedit:TextEditor
                        x:Name="TextEditor"
                        Margin="10,10,10,49"
                        Padding="0,5,5,5"
                        FontSize="15"
                        ShowLineNumbers="True"
                        WordWrap="True">
                        <avalonedit:TextEditor.ContextMenu>
                            <ContextMenu Name="TreeContextMenu" Visibility="Visible">
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="MenuCopy_Click"
                                    Cursor="Hand"
                                    Header="复制">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="MenuPaste_Click"
                                    Cursor="Hand"
                                    Header="粘贴">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/paste.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="MenuDelete_Click"
                                    Cursor="Hand"
                                    Header="删除">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/delete.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Margin="0,0,10,0" />
                                <MenuItem
                                    VerticalAlignment="Center"
                                    Click="Ningcunwei_Click"
                                    Cursor="Hand"
                                    Header="另存为...">
                                    <MenuItem.Icon>
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="pack://application:,,,/WDB;component/Resources/save_as.png" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </avalonedit:TextEditor.ContextMenu>
                        <avalonedit:TextEditor.Options>
                            <avalonedit:TextEditorOptions ShowSpaces="False">
                                <avalonedit:TextEditorOptions.ColumnRulerPosition>
                                    <system:Int32>10</system:Int32>
                                </avalonedit:TextEditorOptions.ColumnRulerPosition>
                            </avalonedit:TextEditorOptions>
                        </avalonedit:TextEditor.Options>
                    </avalonedit:TextEditor>

                    <Grid Margin="10">
                        <StackPanel
                            Height="30"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BtnFormatter"
                                Width="80"
                                Height="28"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                hc:IconElement.Geometry="{StaticResource CodeEGeometry}"
                                Click="BtnFormatter_Click"
                                Content="格式化"
                                Cursor="Hand"
                                Style="{StaticResource ButtonSuccess}" />
                            <Button
                                x:Name="BtnCompress"
                                Width="80"
                                Height="28"
                                Margin="10,0,0,0"
                                hc:IconElement.Geometry="{StaticResource YaSuoGeometry}"
                                Click="BtnCompress_Click"
                                Content="压缩"
                                Cursor="Hand"
                                Style="{StaticResource ButtonWarning}" />
                            <Button
                                x:Name="BtnCopyScript"
                                Width="80"
                                Height="28"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
                                Click="BtnCopyScript_Click"
                                Content="复制"
                                Cursor="Hand"
                                Style="{StaticResource ButtonPrimary}" />
                        </StackPanel>
                        <Button
                            x:Name="BtnClear"
                            Width="80"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            hc:IconElement.Geometry="{StaticResource ClearGeometry}"
                            BorderThickness="0.6"
                            Click="BtnClear_Click"
                            Content="清空"
                            Cursor="Hand" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
