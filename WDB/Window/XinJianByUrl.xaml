<hc:Window
    x:Class="WDB.Window.XinJianByUrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="URL / JDBC 自动识别"
    Width="680"
    Height="500"
    Background="{DynamicResource SecondaryRegionBrush}"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Text="粘贴数据库 URL/JDBC 连接串,或直接粘贴配置片段(url、username、password),将自动识别类型打开对应的新建窗口"
            TextWrapping="Wrap" />

        <hc:TextBox
            Name="txtUrl"
            Grid.Row="1"
            Height="150"
            VerticalContentAlignment="Top"
            hc:InfoElement.Placeholder="jdbc:mysql://127.0.0.1:3306/mysql?useSSL=false"
            hc:InfoElement.ShowClearButton="True"
            AcceptsReturn="True"
            HorizontalScrollBarVisibility="Disabled"
            TextChanged="TxtUrl_TextChanged"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <Image
                Name="imgType"
                Width="16"
                Height="16"
                Margin="0,0,6,0"
                VerticalAlignment="Center" />
            <TextBlock Name="tbResult" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            VerticalAlignment="Top"
            Foreground="#FF9E9E9E"
            Text="示例:&#x0a;jdbc:mysql://root:123@127.0.0.1:3306/test&#x0a;jdbc:sqlserver://127.0.0.1:1433;databaseName=test;user=sa;password=123&#x0a;jdbc:oracle:thin:@//127.0.0.1:1521/orcl&#x0a;postgresql://user:pwd@127.0.0.1:5432/postgres    redis://127.0.0.1:6379    mongodb://user:pwd@127.0.0.1:27017/admin&#x0a;配置片段(可从配置文件整段复制):&#x0a;url: jdbc:mysql://127.0.0.1:3306/mysql?useSSL=false&#x0a;username: root&#x0a;password: 123456"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Name="btnOk"
                Width="100"
                Height="30"
                Margin="0,0,10,0"
                hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                Click="BtnQueding"
                Content="确定"
                IsEnabled="False"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Width="100"
                Height="30"
                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                Background="DarkRed"
                BorderThickness="0"
                Click="BtnQuxiao"
                Content="关闭"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</hc:Window>
