<UserControl
    x:Class="WDB.Window.BiaoJieGou"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:WDB="clr-namespace:WDB"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:common="clr-namespace:WDB.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <WDB:BiaoJieGouModel />
    </UserControl.DataContext>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Label
                Width="80"
                Margin="5,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Style="{StaticResource BaseStyle}">
                所属连接:
            </Label>
            <Label
                Margin="5,5,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Content="{Binding LianjieMing}"
                Style="{StaticResource BaseStyle}"
                ToolTip="{Binding LianjieMing}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label
                Width="80"
                Margin="5,0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Style="{StaticResource BaseStyle}">
                表名称:
            </Label>
            <TextBox
                Width="180"
                Margin="10"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                Style="{StaticResource BaseStyle}"
                Text="{Binding BiaoMing}" />
            <Label
                Width="80"
                Margin="5,0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Style="{StaticResource BaseStyle}">
                表注释:
            </Label>
            <TextBox
                Width="180"
                Margin="10"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                Style="{StaticResource BaseStyle}"
                Text="{Binding BiaoZhuShi}" />
        </StackPanel>
        <TabControl Grid.Row="2">
            <TabItem Width="100" Header="字段">
                <DataGrid
                    Name="dg"
                    hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                    hc:DataGridAttach.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding ZiDuanList}"
                    RowHeaderWidth="60"
                    SelectionUnit="CellOrRowHeader">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="Fz_Click" Header="复制">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Click="FzXtf_Click" Header="复制(小驼峰)" />
                            <MenuItem Click="FzDtf_Click" Header="复制(大驼峰)" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="13*"
                            Binding="{Binding Name}"
                            Header="字段名"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="15*"
                            Binding="{Binding Comment}"
                            Header="注释"
                            IsReadOnly="True" />
                        <DataGridCheckBoxColumn
                            Width="6*"
                            Binding="{Binding Notnull}"
                            Header="非空"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="10*"
                            Binding="{Binding Type}"
                            Header="类型"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="8*"
                            Binding="{Binding DefaultValue}"
                            Header="默认值"
                            IsReadOnly="True" />
                        <DataGridCheckBoxColumn
                            Width="6*"
                            Binding="{Binding IsPK}"
                            Header="主键"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Width="100" Header="SQL">
                <avalonedit:TextEditor
                    Name="TextEditor"
                    Grid.Row="1"
                    common:AvalonEditBindings.BoundText="{Binding SqlStr, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14"
                    ShowLineNumbers="True"
                    WordWrap="True">
                    <avalonedit:TextEditor.ContextMenu>
                        <ContextMenu Name="TreeContextMenu" Visibility="Visible">
                            <MenuItem
                                VerticalAlignment="Center"
                                Click="Meihua_Click"
                                Cursor="Hand"
                                Header="美化SQL">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="pack://application:,,,/WDB;component/Resources/sql_plan.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Margin="0,0,10,0" />
                            <MenuItem
                                VerticalAlignment="Center"
                                Click="MenuCopy_Click"
                                Cursor="Hand"
                                Header="复制">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="pack://application:,,,/WDB;component/Resources/copy.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                VerticalAlignment="Center"
                                Click="MenuPaste_Click"
                                Cursor="Hand"
                                Header="粘贴">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="pack://application:,,,/WDB;component/Resources/paste.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                VerticalAlignment="Center"
                                Click="MenuDelete_Click"
                                Cursor="Hand"
                                Header="删除">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="pack://application:,,,/WDB;component/Resources/delete.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Margin="0,0,10,0" />
                            <MenuItem
                                VerticalAlignment="Center"
                                Click="Ningcunwei_Click"
                                Cursor="Hand"
                                Header="另存为...">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="pack://application:,,,/WDB;component/Resources/save_as.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </avalonedit:TextEditor.ContextMenu>
                    <avalonedit:TextEditor.Options>
                        <avalonedit:TextEditorOptions EnableTextDragDrop="True" />
                    </avalonedit:TextEditor.Options>
                </avalonedit:TextEditor>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
