<hc:Window
    x:Class="WDB.Window.GuanYu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="关于"
    Width="500"
    Height="450"
    Background="{DynamicResource SecondaryRegionBrush}"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <GroupBox Margin="10" Header="说明">
                <StackPanel Height="80">
                    <Label Content="本软件版权所有 微信:tianyuyaoxi QQ:756090666" Style="{StaticResource BaseStyle}" />
                    <Label Content="软件试用期间所有功能都可使用,过期后连接数限制3个" Style="{StaticResource BaseStyle}" />
                    <Label Content="将机器码发给作者获取激活码即可激活软件不限制任何功能" Style="{StaticResource BaseStyle}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="10" Header="激活">
                <StackPanel Height="160">
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Label Content="激活状态:" Style="{StaticResource BaseStyle}" />
                        <Label
                            Name="labJhzt"
                            Content=""
                            Style="{StaticResource BaseStyle}" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Label Content="机器码:" Style="{StaticResource BaseStyle}" />
                        <TextBox
                            Name="txtJqm"
                            Width="300"
                            Margin="5,0,0,0"
                            IsReadOnly="True" />
                        <Button
                            Width="100"
                            Margin="5,0,0,0"
                            hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
                            Click="BtnFuzhi"
                            Style="{StaticResource ButtonWarning}">
                            复制机器码
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Label Content="激活码:" Style="{StaticResource BaseStyle}" />
                        <hc:TextBox
                            Name="txtJhm"
                            Width="300"
                            Height="80"
                            Margin="5,0,0,0"
                            VerticalContentAlignment="Top"
                            hc:InfoElement.Placeholder="请输入激活码"
                            hc:InfoElement.ShowClearButton="True"
                            AcceptsReturn="True"
                            HorizontalScrollBarVisibility="Disabled"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <Button
                            Width="100"
                            Margin="5,0,0,0"
                            VerticalAlignment="Top"
                            hc:IconElement.Geometry="{StaticResource StartGeometry}"
                            Click="BtnJihuo"
                            Style="{StaticResource ButtonSuccess}">
                            激活
                        </Button>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <Button
            Width="100"
            Margin="0,10,10,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
            Background="DarkRed"
            BorderThickness="0"
            Click="BtnGuanBi"
            Content="关闭"
            Style="{StaticResource ButtonPrimary}" />
    </Grid>
</hc:Window>
