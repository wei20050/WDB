<hc:Window
    x:Class="WDB.Window.AiModelEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrol="clr-namespace:WDB.View"
    Title="模型配置"
    Width="500"
    Height="300"
    Background="{DynamicResource SecondaryRegionBrush}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,4"
            Orientation="Horizontal">
            <Label
                Width="60"
                HorizontalContentAlignment="Right"
                Content="配置名称:"
                Style="{StaticResource BaseStyle}" />
            <hc:TextBox
                Width="400"
                hc:InfoElement.Placeholder="请输入配置名称(不可重复，不写配置名称默认取模型名称)"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,4"
            Orientation="Horizontal">
            <Label
                Width="60"
                HorizontalContentAlignment="Right"
                Content="接口地址:"
                Style="{StaticResource BaseStyle}" />
            <hc:TextBox
                Width="400"
                hc:InfoElement.Placeholder="如 https://api.siliconflow.cn/v1(可只填到 /v1)"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="0,4"
            Orientation="Horizontal">
            <Label
                Width="60"
                HorizontalContentAlignment="Right"
                Content="模型名称:"
                Style="{StaticResource BaseStyle}" />
            <hc:TextBox
                Width="400"
                hc:InfoElement.Placeholder="请输入模型名称"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            Margin="0,4"
            Orientation="Horizontal">
            <Label
                Width="60"
                HorizontalContentAlignment="Right"
                Content="密钥:"
                Style="{StaticResource BaseStyle}" />
            <hc:TextBox
                Width="400"
                hc:InfoElement.Placeholder="请输入 API Key"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Grid Grid.Row="4" VerticalAlignment="Bottom">
            <!--  测试按钮放左侧:按当前填写的地址/模型/密钥发一次最小请求,验证配置是否可用  -->
            <Button
                Name="BtnTest"
                Width="90"
                HorizontalAlignment="Left"
                Click="BtnTest_Click"
                Content="测试"
                Cursor="Hand"
                Style="{StaticResource ButtonPrimary}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="90"
                    Margin="0,0,8,0"
                    Click="BtnOk_Click"
                    Content="保存"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Width="90"
                    Click="BtnCancel_Click"
                    Content="取消" />
            </StackPanel>
        </Grid>
        <usercontrol:Loading
            x:Name="LoadingG"
            Grid.RowSpan="5"
            Visibility="Collapsed" />
    </Grid>
</hc:Window>
