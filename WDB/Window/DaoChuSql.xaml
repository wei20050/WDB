<hc:Window
    x:Class="WDB.Window.DaoChuSql"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="导出SQL"
    Width="620"
    Height="620"
    Background="{DynamicResource SecondaryRegionBrush}"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid x:Name="gridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <GroupBox
            Name="gbOption"
            Grid.Row="0"
            Margin="10,10,10,0"
            Header="导出选项">
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    Name="rbJiegou"
                    Margin="10,5"
                    Content="仅导出结构" />
                <RadioButton
                    Name="rbShuju"
                    Margin="10,5"
                    Content="导出结构和数据"
                    IsChecked="True" />
                <CheckBox
                    Name="cbDrop"
                    Margin="10,5"
                    Content="包含删表语句" />
                <TextBlock
                    Margin="0,5"
                    Foreground="DarkRed"
                    Text="勾选后导入时会先删除已存在的同名表/视图" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Name="gbBiao"
            Grid.Row="1"
            Margin="10"
            Header="选择要导出的表">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="5"
                    Orientation="Horizontal">
                    <hc:TextBox
                        Name="txtKey"
                        Width="280"
                        hc:InfoElement.Placeholder="输入表名筛选"
                        hc:InfoElement.ShowClearButton="True"
                        TextChanged="TxtKey_TextChanged" />
                    <Button
                        Width="70"
                        Margin="10,0,0,0"
                        Click="BtnQuanXuan"
                        Content="全选" />
                    <Button
                        Width="70"
                        Margin="10,0,0,0"
                        Click="BtnQuanBuXuan"
                        Content="全不选" />
                    <TextBlock
                        Name="tbCount"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray" />
                </StackPanel>
                <ListBox
                    Name="lbBiao"
                    Grid.Row="1"
                    Margin="5"
                    PreviewMouseLeftButtonDown="LbBiao_PreviewMouseLeftButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="5,3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ShowName}" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SecondaryRegionBrush}"
                                    CornerRadius="2">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{Binding TypeName}" />
                                </Border>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="{Binding Comment}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <StackPanel
            Name="panelProgress"
            Grid.Row="2"
            Margin="10,0,10,0"
            Visibility="Collapsed">
            <TextBlock
                Name="tbStatus"
                Margin="0,0,0,5"
                Text="准备导出..." />
            <ProgressBar
                Name="pb"
                Height="16"
                Maximum="100"
                Minimum="0" />
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Name="BtnOk"
                Width="100"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                Click="BtnDaoChu"
                Content="导出"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Name="BtnCancel"
                Width="100"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="DarkGoldenrod"
                BorderThickness="0"
                Click="BtnQuXiaoDaoChu"
                Content="取消导出"
                Style="{StaticResource ButtonPrimary}"
                Visibility="Collapsed" />
            <Button
                Width="100"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                Background="DarkRed"
                BorderThickness="0"
                Click="BtnGuanbi"
                Content="关闭"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</hc:Window>
