<hc:Window
    x:Class="WDB.Window.DaoruDaochu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WDB.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title=""
    Width="800"
    Height="500"
    Background="{DynamicResource SecondaryRegionBrush}"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:IconConvert x:Key="IconConvert" />
    </Window.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid
            Name="dg"
            hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
            AutoGenerateColumns="False"
            HeadersVisibility="All"
            RowHeaderWidth="60"
            SelectionUnit="FullRow">
            <!--  选中行不变色:HandyControl 默认选中是深蓝底+白字,这里统一成白底黑字  -->
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource DataGridRowStyle}" TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <!--  窗口失焦时 HandyControl 会换成另一套选中色,一并统一  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style BasedOn="{StaticResource DataGridCellStyle}" TargetType="DataGridCell">
                    <Style.Triggers>
                        <!--  HandyControl 在 SelectionUnit=FullRow 且选中时会把单元格文字刷成 TextIconBrush(白),这里压回正文黑  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowHeaderTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                </DataTemplate>
            </DataGrid.RowHeaderTemplate>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Grid
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        Source="{Binding ., Converter={StaticResource IconConvert}}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding Host}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding Port}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding DataBaseName}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding ServiceName}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding UserName}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel
            Grid.Row="1"
            Margin="10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Name="BtnBc"
                Width="100"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                Click="BtnBaocun"
                Content="保存"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Name="BtnSc"
                Grid.Row="1"
                Width="100"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:IconElement.Geometry="{StaticResource ClearGeometry}"
                Background="DarkGoldenrod"
                BorderThickness="0"
                Click="BtnBaocun"
                Content="删除"
                Style="{StaticResource ButtonPrimary}"
                Visibility="Collapsed" />
            <Button
                Grid.Row="1"
                Width="100"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                Background="DarkRed"
                BorderThickness="0"
                Click="BtnGuanbi"
                Content="关闭"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</hc:Window>
