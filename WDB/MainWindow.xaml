<hc:GlowWindow
    x:Class="WDB.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:WDB="clr-namespace:WDB"
    xmlns:converters="clr-namespace:WDB.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WDB.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrol="clr-namespace:WDB.View"
    Title="WDB"
    Width="1000"
    Height="600"
    Background="{DynamicResource SecondaryRegionBrush}"
    Closing="GlowWindow_Closing"
    Icon="main.ico"
    Loaded="Window_Loaded"
    ResizeMode="CanResizeWithGrip"
    ShowTitle="False"
    StateChanged="GlowWindow_StateChanged"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.DataContext>
        <WDB:MainWindowModel />
    </Window.DataContext>
    <Window.Resources>
        <!--  连接树统一节点模板(连接/数据库/模式/表/视图/Redis库)  -->
        <HierarchicalDataTemplate DataType="{x:Type entity:DbNode}" ItemsSource="{Binding Children, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                ToolTip="{Binding ToolTipText}">
                <Image
                    Width="16"
                    Height="16"
                    Margin="0,0,5,0"
                    Source="{Binding Icon}" />
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBold}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <!--  加载失败提示:直接显示在该节点下面,红字  -->
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Text="{Binding Comment}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <!--  顶部栏菜单  -->
    <hc:GlowWindow.NonClientAreaContent>
        <StackPanel
            Height="29"
            Margin="25,0,0,0"
            Orientation="Horizontal">
            <Menu HorizontalAlignment="Left">
                <MenuItem Name="XinJian" Header="新建连接">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Source="pack://application:,,,/WDB;component/Resources/addconnect.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="XinJianChaXun_OnClick" Header="新建查询">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/sql_script_create.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="DaoRu_OnClick" Header="导入连接">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/import.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="DaoChu_OnClick" Header="导出连接">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/export.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="Shanchu_OnClick" Header="删除连接">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/delete.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="SqlLog_Click" Header="执行历史">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/sql_plan.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="GongJu_OnClick" Header="常用工具">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/tools.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="AiDuiHua_OnClick" Header="AI对话">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/ai.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="SheZhi_OnClick" Header="设置">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/configuration.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="GuanYu_OnClick" Header="关于">
                    <MenuItem.Icon>
                        <Image
                            Width="15"
                            Height="15"
                            Margin="0,1,0,0"
                            Source="pack://application:,,,/WDB;component/Resources/info.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </Menu>
            <!--  软件授权状态(试用中剩余天数/已激活/已过期)  -->
            <TextBlock
                x:Name="txtJhzt"
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="Gray" />
        </StackPanel>
    </hc:GlowWindow.NonClientAreaContent>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="100" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <hc:TextBox
                Grid.Row="0"
                Margin="3,0,0,0"
                hc:InfoElement.Placeholder="请输入筛选文本"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="TextBox_TextChanged" />
            <TreeView
                Name="tvLianjie"
                Grid.Row="1"
                Margin="3,0,0,3"
                AllowDrop="True"
                DragEnter="tvLianjie_DragEnter"
                Drop="tvLianjie_Drop"
                ItemsSource="{Binding LianJieBindList, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tvLianjie_KeyDown"
                MouseDoubleClick="tvLianjie_MouseDoubleClick"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource BaseStyle}" TargetType="{x:Type TreeViewItem}">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRadius0Margin0}" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="{TemplateBinding MinHeight}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            Name="Bd"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                            SnapsToDevicePixels="true">
                                            <DockPanel Margin="{Binding Converter={StaticResource TreeViewItemMarginConverter}, RelativeSource={RelativeSource TemplatedParent}}" LastChildFill="True">
                                                <ToggleButton
                                                    Name="Expander"
                                                    ClickMode="Press"
                                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Style="{StaticResource ExpandCollapseToggleStyle}" />
                                                <ContentPresenter
                                                    Name="PART_Header"
                                                    VerticalAlignment="Center"
                                                    ContentSource="Header"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </DockPanel>
                                        </Border>
                                        <ItemsPresenter Name="ItemsHost" Grid.Row="1" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsExpanded" Value="false">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="false">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter Property="Foreground" Value="{StaticResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>
        <GridSplitter
            Grid.Column="1"
            Width="3"
            Height="Auto"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />
        <hc:TabControl
            Name="tc"
            Grid.Column="2"
            Margin="0,0,3,3"
            Background="White"
            hc:ShowCloseButton="True"
            DisplayMemberPath="Header"
            ItemsSource="{Binding}"
            PreviewMouseRightButtonDown="Tc_PreviewMouseRightButtonDown"
            ShowContextMenu="False">
            <hc:TabControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource TabItemPlusBaseStyle}" TargetType="{x:Type hc:TabItem}">
                    <Style.Triggers>
                        <!--  固定标签(首页)不显示关闭按钮  -->
                        <DataTrigger Binding="{Binding CanClose}" Value="False">
                            <Setter Property="ShowCloseButton" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </hc:TabControl.ItemContainerStyle>
            <hc:TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentPresenter Content="{Binding Content}" />
                </DataTemplate>
            </hc:TabControl.ContentTemplate>
        </hc:TabControl>
        <usercontrol:Loading
            x:Name="LoadingG"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Visibility="Collapsed" />
        <hc:NotifyIcon
            Name="ni"
            Click="XianShi_OnClick"
            IsBlink="False"
            Text="WDB"
            Visibility="Visible">
            <hc:NotifyIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="XianShi_OnClick" Header="显示" />
                    <MenuItem Click="SheZhi_OnClick" Header="设置" />
                    <MenuItem Click="RiZhi_OnClick" Header="日志" />
                    <MenuItem Click="TuiChu_OnClick" Header="退出" />
                </ContextMenu>
            </hc:NotifyIcon.ContextMenu>
        </hc:NotifyIcon>
    </Grid>
</hc:GlowWindow>
