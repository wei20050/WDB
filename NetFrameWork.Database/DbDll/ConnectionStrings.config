<connectionStrings>
	<!--是否记录数据库日志(0:不记录 1:记录)-->
	<add name="SqlLog" connectionString="1"/>
	<!--数据库加密秘钥-->
	<add name="SqlEncryptKey" connectionString="password"/>
	<!--数据库地址配置-->
	<add name="DbContext" connectionString="server=localhost;database=mydb;user id=root;password=123456;" providerName="MySql.Data.MySqlClient" />
	<add name="SqliteConnection" connectionString="Data Source=D:\mydb.db;Version=3;" providerName="System.Data.SQLite"/>
	<add name="MySqlConnection" connectionString="server=localhost;database=mydb;user id=root;password=123456;" providerName="MySql.Data.MySqlClient" />
	<add name="MsSqlConnection" connectionString="Data Source=localhost;Initial Catalog=mydb;User ID=sa;Password=123456;Integrated Security=false;" providerName="System.Data.SqlClient" />
	<add name="OracleConnection" connectionString="Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521)))(CONNECT_DATA=(SERVICE_NAME=orcl)));Persist Security Info=True;User Id=mydb;Password=123456;" providerName="System.Data.OracleClient" />
	<add name="DmConnection" connectionString="server=localhost;database=dbname;User Id=SYSDBA;PWD=SYSDBA" providerName="System.Data.Dm"/>
	<add name="KdbConnection" connectionString="Server=localhost;Port=54321;Database=DatabaseName;User Id=root;Password=123456;SearchPath=SchemaName" providerName="System.Data.Kdbndp"/>
	<add name="pgsqlConnection" connectionString="Server=localhost;Port=54321;Database=DatabaseName;User Id=root;Password=123456;SearchPath=SchemaName" providerName="System.Data.Npgsql"/>
	<!--高斯数据库(openGauss)使用官方 OpenGauss.NET 驱动,providerName 保留 System.Data.GaussDB 兼容旧配置-->
	<add name="GaussConnection" connectionString="Server=localhost;Port=54321;Database=DatabaseName;User Id=root;Password=123456;SearchPath=SchemaName" providerName="System.Data.OpenGauss"/>
</connectionStrings>